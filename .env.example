# Frontend (Vite) - filled in after deploying the contracts
# Set to 1 to point the wallet layer at Robinhood Chain testnet (46630)
VITE_ROBINHOOD_TESTNET=1
# Free WalletConnect project id from https://cloud.walletconnect.com
# (unlocks QR / mobile wallet connects; injected wallets work without it)
VITE_WALLETCONNECT_PROJECT_ID=
VITE_TOKEN_ADDRESS=
VITE_CARDS_ADDRESS=
VITE_ORACLE_ADDRESS=
VITE_SALE_ADDRESS=
VITE_SWAP_ADDRESS=
# Optional: direct link to the POKE launch pool on a DEX (shown on /token)
VITE_DEX_POOL_URL=
# Optional pokemontcg.io key. WARNING: every VITE_ value is baked into the
# shipped browser bundle, so anything set here is public to all visitors.
# Leave unset (the free tier plus the vendored card data suffice) or proxy
# the API through a serverless function that holds the key server-side.
VITE_POKEMONTCG_API_KEY=
