# Robinhood Chain contracts - copy to .env
# Funded EOA that deploys contracts and/or acts as keeper
PRIVATE_KEY=
KEEPER_ADDRESS=
KEEPER_PRIVATE_KEY=

# RPC endpoints (public ones are rate-limited; use Alchemy/QuickNode for prod)
RPC_TESTNET_URL=https://rpc.testnet.chain.robinhood.com
RPC_MAINNET_URL=https://rpc.mainnet.chain.robinhood.com
KEEPER_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deploy settings
# 1 = deploy MockMilestonePriceOracle (testnet/local). 0 = use ORACLE_ADDRESS
MOCK_ORACLE=1
ORACLE_ADDRESS=
# Comma-separated USD market-cap milestones for each card
THRESHOLDS=5000,10000,25000,50000,100000,250000,500000,1000000
# Seconds the market cap must hold above a threshold before minting (0 = instant)
CONFIRM_WINDOW=0
BASE_TOKEN_URI=ipfs://pokecard-lab/

# Keeper
CARDS_ADDRESS=
INTERVAL_MS=30000
