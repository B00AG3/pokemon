# Robinhood Chain contracts - copy to .env
# Funded EOA that deploys contracts and acts as treasury
PRIVATE_KEY=
# Dedicated keeper wallet (mints milestone cards). Fund with gas money and
# keep the key secure; it must never be the same as PRIVATE_KEY in prod.
KEEPER_ADDRESS=
KEEPER_PRIVATE_KEY=

# RPC endpoints (public ones are rate-limited; use Alchemy/QuickNode for prod)
RPC_TESTNET_URL=https://rpc.testnet.chain.robinhood.com
RPC_MAINNET_URL=https://rpc.mainnet.chain.robinhood.com
KEEPER_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deploy settings
# 1 = deploy MockMilestonePriceOracle (testnet/local). 0 = use ORACLE_ADDRESS
MOCK_ORACLE=1
ORACLE_ADDRESS=
# Comma-separated USD market-cap milestones for each card
THRESHOLDS=5000,10000,25000,50000,100000,250000,500000,1000000
# Seconds the market cap must hold above a threshold before minting
# (60+ on testnet for realism; hours on mainnet)
CONFIRM_WINDOW=60
BASE_TOKEN_URI=ipfs://pokecard-lab/
# 1 = also deploy the treasury CardSale contract
DEPLOY_SALE=1
# Treasury sale base price in wei at a card's own launch milestone
# (testnet demo uses 5e14 = 0.0005 ETH; pick real value for mainnet)
SALE_BASE_PRICE_WEI=500000000000000

# Keeper loop
CARDS_ADDRESS=
SALE_ADDRESS=
INTERVAL_MS=30000
