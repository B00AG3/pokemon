# Robinhood Chain contracts - copy to .env
# Funded EOA that deploys contracts and acts as treasury
PRIVATE_KEY=
# Dedicated keeper wallet (mints milestone cards). Fund with gas money and
# keep the key secure; it must never be the same as PRIVATE_KEY in prod.
KEEPER_ADDRESS=
KEEPER_PRIVATE_KEY=

# RPC endpoints (public ones are rate-limited; use Alchemy/QuickNode for prod)
RPC_TESTNET_URL=https://rpc.testnet.chain.robinhood.com
RPC_MAINNET_URL=https://rpc.mainnet.chain.robinhood.com
KEEPER_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deploy settings
# Existing POKE ERC-20 (e.g. a launchpad token) to bind the draw to; leave
# empty to deploy a fresh PokeCardToken. On launch day this is the token the
# user creates on the Pons website UI and hands to the conductor.
TOKEN_ADDRESS=
# 1 = deploy MockMilestonePriceOracle (testnet/local). 0 = production oracle:
# set ORACLE_ADDRESS, or leave it empty and set CURVE_ADDRESS (Pons bonding
# curve, pre-graduation), the V4_* vars (Uniswap v4 pool), or V3_* vars to
# deploy a spot oracle. MOCK_ORACLE=1 is refused on robinhoodMainnet.
MOCK_ORACLE=1
ORACLE_ADDRESS=
# Pons bonding curve of a pre-graduation token (smoke-mainnet resolves it
# from the factory automatically and passes it here)
CURVE_ADDRESS=
# Pons path: the token's Uniswap v3 pool. Leave V3_POOL_ADDRESS empty with a
# Pons TOKEN_ADDRESS and deploy.ts discovers it via liquidityPool(). WETH
# defaults to Robinhood Chain mainnet WETH.
V3_POOL_ADDRESS=
V3_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# Oracle deploy inputs (when MOCK_ORACLE=0 and ORACLE_ADDRESS is empty)
V4_STATEVIEW_ADDRESS=
V4_WETH_ADDRESS=
ETH_USD_FEED_ADDRESS=
V4_POOL_FEE=3000
V4_TICK_SPACING=60
V4_HOOKS=0x0000000000000000000000000000000000000000
ORACLE_MAX_STALENESS=3600
# Comma-separated USD market-cap milestones, one per card, strictly
# ascending. Default = the 30-rung launch ladder: $20k first card, +$10k per
# rung, up to $310k for card 30. launch-cards.ts requires EXACTLY 30 values
# (the site ladder serves 30 cards); deploy.ts accepts shorter smoke ladders.
THRESHOLDS=20000,30000,40000,50000,60000,70000,80000,90000,100000,110000,120000,130000,140000,150000,160000,170000,180000,190000,200000,210000,220000,230000,240000,250000,260000,270000,280000,290000,300000,310000
# Seconds the market cap must hold above a threshold before minting
# (60+ on testnet for realism; hours on mainnet; 3600 recommended)
CONFIRM_WINDOW=60
# Seconds a cap checkpoint must age before it prices redemptions and treasury
# sale quotes (21600 = 6h on mainnet; 60 for testnet rehearsals)
REDEEM_DELAY=21600
# ETH (wei) a card is worth at its own launch milestone. Pool sizing: the
# worst-case full-ladder redemption liability is redeemBasePrice x 31 x
# (H(31) - 1) = ~93.85x the base price - ~0.94 ETH at 0.01 ETH base, and
# ~1.41 ETH at the keeper's 150% sweep margin. Fund POOL_FUND_ETH to at
# least that before launch day (base price and pool size are user-gated
# economics; launch-cards warns when POOL_FUND_ETH is below the liability).
REDEEM_BASE_PRICE_WEI=10000000000000000
BASE_TOKEN_URI=ipfs://pokecard-lab/
# 1 = also deploy the treasury CardSale contract (testnet demo default).
# Launch day runs DEPLOY_SALE=0 (it is on the runbook commands): the cutover
# wires no sale and launch-cards prints an empty VITE_SALE_ADDRESS.
DEPLOY_SALE=1
# Treasury sale base price in wei at a card's own launch milestone
# (testnet demo uses 5e14 = 0.0005 ETH; pick real value for mainnet)
SALE_BASE_PRICE_WEI=500000000000000

# Keeper handoff (launch-cards.ts). A distinct KEEPER_ADDRESS (the hosted
# Fly keeper wallet) is accepted only when it already holds gas on-chain:
# the launch aborts read-only BEFORE any transaction unless its balance is
# >= KEEPER_GAS_FLOOR_ETH. Default floor 0.001 ETH; fund the Fly keeper
# wallet before launch day (user-gated).
KEEPER_GAS_FLOOR_ETH=0.001
# 0 (default) = print the fly secrets block for the hosted pokecard-keeper;
# 1 = start a local keeper in this console (smoke-run escape hatch only)
START_KEEPER=0

# Keeper loop
CARDS_ADDRESS=
INTERVAL_MS=30000
# Sweep inputs (SWEEP_MODE etc. are documented in scripts/keeper.ts): set
# POKE_TOKEN and CURVE_ADDRESS once the Pons token exists so the live sweep
# claims curve creator fees into the escrow, then into the redemption pool
POKE_TOKEN=
CURVE_ADDRESS=
