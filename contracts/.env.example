# Robinhood Chain contracts - copy to .env
# Funded EOA that deploys contracts and acts as treasury
PRIVATE_KEY=
# Dedicated keeper wallet (mints milestone cards). Fund with gas money and
# keep the key secure; it must never be the same as PRIVATE_KEY in prod.
KEEPER_ADDRESS=
KEEPER_PRIVATE_KEY=

# RPC endpoints (public ones are rate-limited; use Alchemy/QuickNode for prod)
RPC_TESTNET_URL=https://rpc.testnet.chain.robinhood.com
RPC_MAINNET_URL=https://rpc.mainnet.chain.robinhood.com
KEEPER_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deploy settings
# Existing POKE ERC-20 (e.g. a launchpad token) to bind the draw to; leave
# empty to deploy a fresh PokeCardToken
TOKEN_ADDRESS=
# 1 = deploy MockMilestonePriceOracle (testnet/local). 0 = production oracle:
# set ORACLE_ADDRESS, or leave it empty and set the V4_* vars (Uniswap v4
# pool) or V3_* vars (Pons launch) to deploy a spot oracle. MOCK_ORACLE=1 is
# refused on robinhoodMainnet.
MOCK_ORACLE=1
ORACLE_ADDRESS=
# Pons path: the token's Uniswap v3 pool. Leave V3_POOL_ADDRESS empty with a
# Pons TOKEN_ADDRESS and deploy.ts discovers it via liquidityPool(). WETH
# defaults to Robinhood Chain mainnet WETH.
V3_POOL_ADDRESS=
V3_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# Oracle deploy inputs (when MOCK_ORACLE=0 and ORACLE_ADDRESS is empty)
V4_STATEVIEW_ADDRESS=
V4_WETH_ADDRESS=
ETH_USD_FEED_ADDRESS=
V4_POOL_FEE=3000
V4_TICK_SPACING=60
V4_HOOKS=0x0000000000000000000000000000000000000000
ORACLE_MAX_STALENESS=3600
# Comma-separated USD market-cap milestones for each card
THRESHOLDS=5000,10000,25000,50000,100000,250000,500000,1000000
# Seconds the market cap must hold above a threshold before minting
# (60+ on testnet for realism; hours on mainnet)
CONFIRM_WINDOW=60
# Seconds a cap checkpoint must age before it prices redemptions and treasury
# sale quotes (21600 = 6h on mainnet; 60 for testnet rehearsals)
REDEEM_DELAY=21600
# ETH (wei) a card is worth at its own launch milestone; chart values and the
# redemption pool liability (377x this for the full ladder) scale off it
REDEEM_BASE_PRICE_WEI=10000000000000000
BASE_TOKEN_URI=ipfs://pokecard-lab/
# 1 = also deploy the treasury CardSale contract
DEPLOY_SALE=1
# Treasury sale base price in wei at a card's own launch milestone
# (testnet demo uses 5e14 = 0.0005 ETH; pick real value for mainnet)
SALE_BASE_PRICE_WEI=500000000000000

# Keeper loop
CARDS_ADDRESS=
INTERVAL_MS=30000
